# Flask configuration
FLASK_APP=run.py
FLASK_DEBUG=True
FLASK_ENV=development

# Security
SECRET_KEY=replace-this-with-a-secure-random-key

# Database
# Use sqlite:///gym.db for SQLite, or postgresql://username:password@localhost/gym_db for PostgreSQL
DATABASE_URL=sqlite:///gym.db

# File Uploads
UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size
